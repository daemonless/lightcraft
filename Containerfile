# --------------------------------------------------------------------------
# THIS FILE IS AUTOGENERATED - DO NOT EDIT MANUALLY
#
# Source: Containerfile.j2
# --------------------------------------------------------------------------

ARG NGINX_TAG=pkg-latest
FROM ghcr.io/daemonless/nginx:${NGINX_TAG}

ARG FREEBSD_ARCH=amd64
ARG PACKAGES="ca_root_nss"
ARG UPSTREAM_URL="https://api.github.com/repos/storytold/lightcraft/releases/latest"
ARG UPSTREAM_JQ=".tag_name"

LABEL org.opencontainers.image.title="LightCraft" \
      org.opencontainers.image.description="Open-source, clean-room reimplementation of Adobe Lightroom in Rust, served as a WebAssembly web app on FreeBSD." \
      org.opencontainers.image.source="https://github.com/daemonless/lightcraft" \
      org.opencontainers.image.url="https://getartcraft.com/apps/lightcraft" \
      org.opencontainers.image.documentation="https://github.com/storytold/lightcraft" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Photos & Media" \
      io.daemonless.port="80" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.base="nginx" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.packages="${PACKAGES}"

# The web release is a static WebAssembly site (index.html + .js/.wasm), no server code.
# Some releases ship cargo build leftovers (.fingerprint, build, deps) and .br files nginx
# cannot serve; drop them. Precompress the rest so nginx gzip_static sends ~40% of the raw wasm.
RUN pkg update && pkg install -y ${PACKAGES} && \
    VERSION=$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${UPSTREAM_JQ}" | sed 's/^v//') && \
    echo "Installing LightCraft web ${VERSION}" && \
    fetch -qo /tmp/lightcraft-web.zip "https://github.com/storytold/lightcraft/releases/download/v${VERSION}/lightcraft-web-${VERSION}.zip" && \
    unzip -q /tmp/lightcraft-web.zip -d /tmp/lightcraft-web && \
    mkdir -p /usr/local/www/app /app && \
    mv /tmp/lightcraft-web/lightcraft-web-${VERSION}/* /usr/local/www/app/ && \
    rm -rf /tmp/lightcraft-web /tmp/lightcraft-web.zip && \
    cd /usr/local/www/app && \
    rm -rf _headers build deps examples incremental *.br *.gz && \
    find /usr/local/www/app -type f \( -name '*.wasm' -o -name '*.js' -o -name '*.html' -o -name '*.ttf' -o -name '*.otf' \) -exec gzip -9 -k {} \; && \
    echo "${VERSION}" > /app/version && chmod a+r /app/version && \
    chown -R bsd:bsd /usr/local/www/app && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

COPY root/ /

# nginx -t leaves its pid and temp dirs, root-owned, in /tmp.
RUN nginx -t && rm -rf /tmp/*

EXPOSE 80